generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                   String   @id @default(cuid())
  name                 String
  gstin                String?
  pan                  String?
  address              String?
  city                 String?
  state                String?
  country              String?  @default("India")
  businessType         String?
  status               String   @default("ACTIVE")
  supportAccessGranted Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users             User[]
  clients           Client[]
  products          Product[]
  invoices          Invoice[]
  projects          Project[]
  estimates         Estimate[]
  expenses          Expense[]
  banks             Bank[]
  exchangeRates     ExchangeRate[]
  internalTransfers InternalTransfer[]
  assets            Asset[]
  customRoles       CustomRole[]
  invitations       Invitation[]
  contracts         Contract[]
  settings          CompanySettings?
  subscription      Subscription?
  activityLogs      ActivityLog[]
  tickets           Ticket[]
  platformPayments  PlatformPayment[]
  creditNotes       CreditNote[]
  debitNotes        DebitNote[]
  gstExports        GstExportHistory[]
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  monthlyPrice  Float          @default(0)
  yearlyPrice   Float          @default(0)
  currency      String         @default("INR")
  isPopular     Boolean        @default(false)
  trialPeriod   Int            @default(0)
  userLimits    Int?
  clientLimits  Int?
  invoiceLimits Int?
  displayOrder  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id               String    @id @default(cuid())
  companyId        String    @unique
  planId           String
  status           String    @default("active")
  billingInterval  String    @default("month")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     Plan              @relation(fields: [planId], references: [id])
  payments PlatformPayment[]
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  name         String?
  role         String        @default("admin") // admin, member
  clerkId      String?       @unique
  isSuperAdmin Boolean       @default(false)
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  customRoleId String?
  customRole   CustomRole?   @relation(fields: [customRoleId], references: [id])
  platformRoleId String?
  platformRole   PlatformRole? @relation(fields: [platformRoleId], references: [id])
  comments     Comment[]
  tasks        ProjectTask[]
}

model Client {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  gstin        String?
  address      String?
  email        String?
  phone        String?
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  panNo        String?
  stateCode    String?
  stateName    String?
  portalToken  String?       @unique
  status       String        @default("ACTIVE")
  invoices     Invoice[]
  projects     Project[]
  estimates    Estimate[]
  activityLogs ActivityLog[]
  contracts    Contract[]
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String?
  price         Float
  hsn           String?
  gstRate       Float          @default(0)
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  discount      Float          @default(0)
  purchasePrice Float          @default(0)
  unit          String?
  taxInclusive  Boolean        @default(false)
  isHidden      Boolean        @default(false)
  category      String?
  invoiceItems  InvoiceItem[]
  estimateItems EstimateItem[]
}

model CompanySettings {
  id           String   @id @default(cuid())
  companyId    String   @unique
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyName  String   @default("Your Company Name")
  address      String?
  gstin        String?
  logoUrl      String?
  upiId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lutNo        String?
  altPhone     String?
  brandName    String?
  businessType String?
  email        String?
  panNo        String?
  phone        String?
  website      String?
  stateCode    String?  @default("27")
  defaultCurrency String? @default("INR")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String   @unique
  rate      Float
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bank {
  id            String             @id @default(cuid())
  bankName      String
  accountNumber String
  ifsc          String?
  swiftCode     String?
  routingNumber String?
  iban          String?
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  invoices      Invoice[]
  transfersOut  InternalTransfer[] @relation("TransferFrom")
  transfersIn   InternalTransfer[] @relation("TransferTo")
  expenses      Expense[]
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  date            DateTime      @default(now())
  dueDate         DateTime?
  status          String        @default("draft")
  subTotal        Float         @default(0)
  taxTotal        Float         @default(0)
  total           Float         @default(0)
  notes           String?
  clientId        String
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bankId          String?
  currency        String        @default("INR")
  discountType    String?
  discountValue   Float         @default(0)
  invoiceType     String        @default("REGULAR")
  roundOff        Float         @default(0)
  exchangeRate    Float         @default(1.0)
  paymentMethod   String        @default("UPI")
  reference       String?
  amountPaid      Float         @default(0)
  razorpayOrderId String?
  paymentId       String?
  bank            Bank?         @relation(fields: [bankId], references: [id])
  client          Client        @relation(fields: [clientId], references: [id])
  items           InvoiceItem[]
  milestone       Milestone?
  creditNotes     CreditNote[]
  debitNotes      DebitNote[]
}

model InvoiceItem {
  id        String  @id @default(cuid())
  quantity  Int     @default(1)
  price     Float
  tax       Float
  invoiceId String
  productId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  vendorName  String
  category    String   @default("SOFTWARE")
  description String?
  totalAmount Float
  subTotal    Float    @default(0)
  taxRate     Float    @default(0)
  taxAmount   Float    @default(0)
  isRcm       Boolean  @default(false)
  itcEligible Boolean  @default(true)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bankId      String?
  bank        Bank?    @relation(fields: [bankId], references: [id])
}

model Project {
  id                 String        @id @default(cuid())
  name               String
  totalValue         Float
  currency           String        @default("INR")
  status             String        @default("ACTIVE")
  contractText       String?       @db.Text
  stage              String        @default("PLANNING")
  clientId           String
  companyId          String
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  milestones         Milestone[]
  tasks              ProjectTask[]
  contractApprovedAt DateTime?
  contractSignedBy   String?
  projectClosedAt    DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Milestone {
  id               String    @id @default(cuid())
  name             String
  percentage       Float?
  amount           Float
  status           String    @default("UNBILLED")
  clientApprovedAt DateTime?
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceId        String?   @unique
  invoice          Invoice?  @relation(fields: [invoiceId], references: [id])
  orderIndex       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ProjectTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("TODO")
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InternalTransfer {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  amount     Float
  fromBankId String
  toBankId   String
  reference  String?
  notes      String?
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromBank   Bank     @relation("TransferFrom", fields: [fromBankId], references: [id])
  toBank     Bank     @relation("TransferTo", fields: [toBankId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Estimate {
  id             String         @id @default(cuid())
  estimateNumber String         @unique
  date           DateTime       @default(now())
  expiryDate     DateTime?
  status         String         @default("draft")
  subTotal       Float          @default(0)
  taxTotal       Float          @default(0)
  total          Float          @default(0)
  notes          String?
  clientId       String
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         Client         @relation(fields: [clientId], references: [id])
  currency       String         @default("INR")
  discountType   String?
  discountValue  Float          @default(0)
  estimateType   String         @default("REGULAR")
  roundOff       Float          @default(0)
  exchangeRate   Float          @default(1.0)
  items          EstimateItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model EstimateItem {
  id         String   @id @default(cuid())
  quantity   Int      @default(1)
  price      Float
  tax        Float
  estimateId String
  productId  String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  description String?
  clientId    String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  invoiceId String?
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id        String   @id @default(cuid())
  name      String
  url       String
  category  String   @default("GENERAL")
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Contract {
  id        String    @id @default(cuid())
  title     String
  content   String
  clientId  String
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status    String    @default("DRAFT")
  signedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  adminId   String
  targetId  String?
  companyId String?
  metadata  String?  @db.Text
  ipAddress String?
  userAgent String?
  requestId String?
  reason    String?
  createdAt DateTime @default(now())
}

model EmailTemplate {
  id            String     @id @default(cuid())
  name          String     @unique
  subject       String
  htmlBody      String     @db.Text
  plainTextBody String     @db.Text
  variables     String     // Comma-separated variable names
  isEnabled     Boolean    @default(true)
  version       Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  logs          EmailLog[]
}

model EmailLog {
  id                String         @id @default(cuid())
  recipient          String
  templateId         String?
  templateName       String?
  status             String         // "SENT", "DELIVERED", "BOUNCED", "FAILED"
  provider           String         // "ZEPTOMAIL", "SMTP", etc.
  error              String?        @db.Text
  providerMessageId  String?
  sentAt             DateTime       @default(now())
  deliveredAt        DateTime?
  openedAt           DateTime?
  bouncedAt          DateTime?
  
  template           EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

model WebhookLog {
  id           String    @id @default(cuid())
  provider     String    // "RAZORPAY", "STRIPE", etc.
  event        String    // e.g. "payment.authorized"
  status       String    // "SUCCESS", "FAILED", "RETRYING"
  attempt      Int       @default(1)
  payload      String    @db.Text
  response     String?   @db.Text
  error        String?   @db.Text
  createdAt    DateTime  @default(now())
  processedAt  DateTime?
}

model BackgroundJobLog {
  id          String    @id @default(cuid())
  jobName     String    
  queue       String    @default("default")
  status      String    // "PENDING", "RUNNING", "COMPLETED", "FAILED", "RETRYING"
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int?      
  retries     Int       @default(0)
  error       String?   @db.Text
}

model Ticket {
  id        String   @id @default(cuid())
  subject   String
  status    String   @default("OPEN") // OPEN, PENDING, RESOLVED
  priority  String   @default("MEDIUM")
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  target    String   @default("ALL") // ALL, SPECIFIC_PLANS
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformPayment {
  id                   String   @id @default(cuid())
  subscriptionId       String
  companyId            String
  originalAmount       Float
  originalCurrency     String
  exchangeRate         Float    @default(1.0)
  exchangeRateDate     DateTime @default(now())
  convertedAmountInr   Float
  gatewayTransactionId String?
  status               String   @default("SUCCESS")
  createdAt            DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  company      Company      @relation(fields: [companyId], references: [id])
}

model SystemSettings {
  id        String   @id @default("global")
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model CreditNote {
  id             String   @id @default(cuid())
  noteNumber     String   @unique
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amount         Float    @default(0)
  taxAmount      Float    @default(0)
  reason         String
  createdAt      DateTime @default(now())
}

model DebitNote {
  id             String   @id @default(cuid())
  noteNumber     String   @unique
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amount         Float    @default(0)
  taxAmount      Float    @default(0)
  reason         String
  createdAt      DateTime @default(now())
}

model GstExportHistory {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type         String   // "GSTR-1", "GSTR-3B"
  period       String   // e.g. "2026-08"
  validCount   Int
  warningCount Int
  errorCount   Int
  metadata     String?  @db.Text
  createdAt    DateTime @default(now())
}

model SupportAccessToken {
  id           String   @id @default(cuid())
  adminUserId  String
  companyId    String
  reason       String
  expiresAt    DateTime
  allowWrite   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model CustomRole {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions String   // JSON array of permission strings, e.g. ["CREATE_INVOICE", "VIEW_REPORTS"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model PlatformRole {
  id          String   @id @default(cuid())
  name        String
  description String?
  permissions String   // JSON array of strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Invitation {
  id           String   @id @default(cuid())
  email        String
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  customRoleId String?
  platformRoleId String?
  token        String   @unique
  status       String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  invitedBy    String   // ID or email of inviter
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}
